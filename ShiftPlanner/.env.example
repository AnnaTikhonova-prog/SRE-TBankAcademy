# Конфигурация стека ShiftPlanner. Скопируйте в .env:
#   cp .env.example .env
# Файл .env не коммитится в git (фактор III — конфигурация в окружении).

# --- PostgreSQL ---
POSTGRES_DB=shiftplanner
POSTGRES_USER=shiftplanner
POSTGRES_PASSWORD=shiftplanner

# --- JWT ---
# Обязательно замените на длинную случайную строку!
JWT_SECRET_KEY=change-me-to-a-long-random-string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# --- Порты на хосте ---
FRONTEND_PORT=8080
BACKEND_PORT=8000

# --- CORS (нужен только для локальной разработки фронтенда) ---
CORS_ORIGINS=http://localhost:5173
