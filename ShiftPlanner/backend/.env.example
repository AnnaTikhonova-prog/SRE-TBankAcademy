# Пример конфигурации бэкенда. Скопируйте в .env и измените значения.
# Файл .env не коммитится в git (фактор III — конфигурация в окружении).

# Строка подключения к PostgreSQL.
DATABASE_URL=postgresql+psycopg://shiftplanner:shiftplanner@localhost:5432/shiftplanner

# Секрет для подписи JWT — обязательно задайте свой!
JWT_SECRET_KEY=change-me-to-a-long-random-string

# Алгоритм подписи JWT и время жизни токена (минуты).
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Разрешённые источники CORS для локальной разработки (vite dev-server).
CORS_ORIGINS=http://localhost:5173
